---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import { sources } from '../../scrapers/sources';
import { watchlist } from '../../scrapers/watchlist';
import { considered } from '../../scrapers/considered';
import { SOURCE_GROUPS, type SourceGroup } from '../../scrapers/types';
import { loadEvents } from '../lib/load';
import { upcoming } from '../lib/merge';
import { COVERAGE, buildOverview, type Coverage, type SourceRow } from '../lib/overview';

const statePath = resolve(process.cwd(), 'data/watch-state.json');
const watchState = existsSync(statePath) ? JSON.parse(readFileSync(statePath, 'utf8')) : {};
const today = new Date().toISOString().slice(0, 10);
const overview = buildOverview(sources, watchlist, considered, watchState, upcoming(loadEvents(), today));

const order = Object.keys(COVERAGE) as Coverage[];
const pct = (n: number, of: number) => (of ? Math.round((n / of) * 100) : 0);
const inactive = overview.total - overview.counts.active;
const withSignup = overview.rows.filter((r) => r.coverage !== 'active' && r.signup).length;

// Per-group bars share one count scale so their lengths compare.
const groups = (Object.keys(SOURCE_GROUPS) as SourceGroup[])
  .map((g) => ({ id: g, rows: overview.rows.filter((r) => r.group === g) }))
  .filter((g) => g.rows.length > 0);
const maxGroup = Math.max(...groups.map((g) => g.rows.length));

const names = (rows: SourceRow[]) => rows.map((r) => r.organiser).join('; ');
const segments = (rows: SourceRow[]) =>
  order
    .map((c) => ({ coverage: c, rows: rows.filter((r) => r.coverage === c) }))
    .filter((s) => s.rows.length > 0);
const tip = (c: Coverage, rows: SourceRow[], total: number) =>
  `${COVERAGE[c].icon} ${COVERAGE[c].label}: ${rows.length} of ${total} (${pct(rows.length, total)} %)\n${names(rows)}`;
---

<Base title="Sources | Brussels Trainee Events" description="Which event sources are read automatically, and which ones trainees need to check by hand." current="sources">
  <header>
    <h1>Sources</h1>
    <p class="lead">
      Events from <strong>{overview.counts.active}</strong> organisers appear on this site by themselves. For the other{' '}
      <strong>{inactive}</strong>, you need to look yourself{withSignup > 0 && <>, and <strong>{withSignup}</strong> of them let you sign up for event newsletters or invitations</>}.
    </p>
    <p class="muted-small">{overview.total + overview.notTracked.length} organisers were considered in total; the ones we left out are listed at the end.</p>
  </header>

  <section aria-labelledby="coverage-title" class="chart">
    <h2 id="coverage-title">Coverage of tracked sources</h2>
    <div class="bar bar-total" aria-label={order.map((c) => `${COVERAGE[c].label}: ${overview.counts[c]}`).join(', ')}>
      {segments(overview.rows).map((s) => (
        <a
          class={`seg seg-${s.coverage}`}
          style={`flex-grow: ${s.rows.length}`}
          href={`#sec-${s.coverage}`}
          data-tip={tip(s.coverage, s.rows, overview.total)}
          aria-label={`${COVERAGE[s.coverage].label}: ${s.rows.length}. Show list`}
        >
          {pct(s.rows.length, overview.total) >= 8 && <span class="seg-label">{s.rows.length}</span>}
        </a>
      ))}
    </div>
    <ul class="legend">
      {order.map((c) => (
        <li>
          <a href={`#sec-${c}`}>
            <span class={`swatch seg-${c}`} aria-hidden="true">{COVERAGE[c].icon}</span>
            {COVERAGE[c].label} <span class="count">{overview.counts[c]}</span>
          </a>
        </li>
      ))}
    </ul>

    <h3 class="sub">By kind of organiser</h3>
    <div class="groups">
      {groups.map((g) => (
        <div class="group-row">
          <span class="group-name">{SOURCE_GROUPS[g.id]}</span>
          <div class="group-track">
            <div class="bar bar-small" style={`width: ${(g.rows.length / maxGroup) * 100}%`}>
              {segments(g.rows).map((s) => (
                <span
                  class={`seg seg-${s.coverage}`}
                  style={`flex-grow: ${s.rows.length}`}
                  tabindex="0"
                  data-tip={tip(s.coverage, s.rows, g.rows.length)}
                  aria-label={`${SOURCE_GROUPS[g.id]}, ${COVERAGE[s.coverage].label}: ${s.rows.length}`}
                />
              ))}
            </div>
          </div>
          <span class="group-count">
            {g.rows.filter((r) => r.coverage === 'active').length} of {g.rows.length} shown automatically
          </span>
        </div>
      ))}
    </div>
  </section>

  {order.map((c) => {
    const rows = overview.rows.filter((r) => r.coverage === c);
    if (rows.length === 0) return null;
    return (
      <details class="status-section" id={`sec-${c}`} open={c === 'no-calendar' || c === 'blocked'}>
        <summary>
          <span class={`badge seg-${c}`} aria-hidden="true">{COVERAGE[c].icon}</span>
          <span class="sec-label">{COVERAGE[c].label}</span> <span class="count">({rows.length})</span>
        </summary>
        <p class="advice">{COVERAGE[c].advice}</p>
        <ul class="source-list">
          {rows.map((r) => (
            <li id={`src-${r.id}`}>
              <div class="source-name">{r.organiser}</div>
              <div class="source-meta">
                {SOURCE_GROUPS[r.group]}
                {r.upcoming !== undefined && <> · {r.upcoming} upcoming {r.upcoming === 1 ? 'event' : 'events'} on this site</>}
              </div>
              <div class="source-actions">
                {r.signup && (
                  <a class="btn btn-small btn-primary" href={r.signup.url} rel="noopener">✉ {r.signup.label}</a>
                )}
                {r.homepage ? (
                  <a class="btn btn-small" href={r.homepage} rel="noopener">{c === 'active' ? 'Their events page' : 'Open their events page'}</a>
                ) : (
                  <span class="no-signup">Website not known yet</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </details>
    );
  })}

  <details class="not-tracked">
    <summary>Considered but not tracked ({overview.notTracked.length})</summary>
    <ul class="source-list">
      {overview.notTracked.map((s) => (
        <li>
          <div class="source-name">{s.homepage ? <a href={s.homepage} rel="noopener">{s.organiser}</a> : s.organiser}</div>
          <div class="source-meta">{SOURCE_GROUPS[s.group]} · {s.reason}</div>
        </li>
      ))}
    </ul>
  </details>

  <div class="tooltip" role="tooltip" hidden></div>

  <script>
    // One shared tooltip for bar segments (hover and keyboard focus).
    const tooltip = document.querySelector<HTMLElement>('.tooltip')!;
    const show = (el: HTMLElement, x: number, y: number) => {
      tooltip.textContent = el.dataset.tip ?? '';
      tooltip.hidden = false;
      const w = tooltip.offsetWidth;
      tooltip.style.left = `${Math.max(8, Math.min(x - w / 2, window.innerWidth - w - 8))}px`;
      tooltip.style.top = `${y + 14}px`;
    };
    // Segment and legend links open their (possibly collapsed) section.
    const openSection = (hash: string) => {
      const target = hash ? document.querySelector<HTMLDetailsElement>(hash) : null;
      if (target?.tagName === 'DETAILS') target.open = true;
    };
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href^="#sec-"]')) {
      a.addEventListener('click', () => openSection(a.getAttribute('href')!));
    }
    openSection(location.hash);

    for (const seg of document.querySelectorAll<HTMLElement>('[data-tip]')) {
      seg.addEventListener('mousemove', (e) => show(seg, e.clientX, e.clientY));
      seg.addEventListener('mouseleave', () => (tooltip.hidden = true));
      seg.addEventListener('focus', () => {
        const r = seg.getBoundingClientRect();
        show(seg, r.left + r.width / 2, r.bottom - 8);
      });
      seg.addEventListener('blur', () => (tooltip.hidden = true));
    }
  </script>

  <style is:global>
    .chart { margin-top: 8px; }
    .bar { display: flex; gap: 2px; border-radius: 4px; overflow: hidden; }
    .bar-total { height: 32px; }
    .bar-small { height: 14px; min-width: 6px; }
    .seg {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-basis: 0;
      min-width: 6px;
      cursor: pointer;
      text-decoration: none;
      outline-offset: 2px;
    }
    .seg:focus-visible { outline: 2px solid var(--fg); }
    .seg-label { font-weight: 700; font-size: 0.85rem; font-variant-numeric: tabular-nums; }
    .seg-active { background: var(--status-good); color: #fff; }
    .seg-no-calendar { background: var(--status-warning); color: #0b0b0b; }
    .seg-not-located { background: var(--status-neutral); color: #fff; }
    .seg-blocked { background: var(--status-critical); color: #fff; }
    .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 10px 0 0; font-size: 0.9rem; color: var(--muted); }
    .legend li a { display: flex; align-items: center; gap: 6px; color: inherit; text-decoration: none; }
    .legend li a:hover .sec-label, .legend li a:hover { text-decoration: underline; }
    .legend .count { color: var(--fg); font-weight: 600; font-variant-numeric: tabular-nums; }
    .swatch, .badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
      line-height: 1;
    }
    .sub { font-size: 0.95rem; margin: 24px 0 8px; color: var(--muted); font-weight: 600; }
    .groups { display: grid; gap: 8px; }
    .group-row { display: grid; grid-template-columns: 13rem 1fr auto; gap: 12px; align-items: center; font-size: 0.9rem; }
    .group-name { color: var(--fg); }
    .group-count { color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .lead { font-size: 1rem; color: var(--fg) !important; }
    .muted-small { font-size: 0.85rem; }
    .status-section { margin-top: 20px; border-top: 1px solid var(--line); padding-top: 10px; scroll-margin-top: 12px; }
    .status-section > summary { display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 1.1rem; font-weight: 700; list-style: none; }
    .status-section > summary::-webkit-details-marker { display: none; }
    .status-section > summary::after { content: '▸'; margin-left: auto; color: var(--muted); }
    .status-section[open] > summary::after { content: '▾'; }
    .status-section .count { color: var(--muted); font-weight: 400; }
    .source-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
    .advice { margin: 0 0 8px; color: var(--muted); font-size: 0.9rem; }
    .source-list li { padding: 8px 0; border-bottom: 1px solid var(--line); }
    .source-name { font-weight: 600; }
    .source-meta { color: var(--muted); font-size: 0.85rem; }
    .no-signup { color: var(--muted); font-style: italic; font-size: 0.85rem; align-self: center; }
    .not-tracked { margin-top: 28px; }
    .not-tracked summary { cursor: pointer; font-weight: 600; }
    .tooltip {
      position: fixed;
      z-index: 10;
      max-width: min(360px, calc(100vw - 16px));
      padding: 8px 10px;
      border-radius: 6px;
      background: var(--fg);
      color: var(--bg);
      font-size: 0.8rem;
      white-space: pre-line;
      pointer-events: none;
      box-shadow: 0 2px 8px rgb(0 0 0 / 0.2);
    }
    @media (max-width: 560px) {
      .groups { gap: 14px; }
      .group-row { grid-template-columns: 1fr auto; row-gap: 4px; }
      .group-track { grid-column: 1 / -1; grid-row: 2; }
    }
  </style>
</Base>

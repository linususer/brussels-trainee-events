---
import Base from '../layouts/Base.astro';
import { loadEvents } from '../lib/load';
import { upcoming } from '../lib/merge';
import { CATEGORIES, REGISTRATION, isAllDay, type Category, type Event } from '../lib/event';

const today = new Date().toISOString().slice(0, 10);
const events = upcoming(loadEvents(), today);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const monthFmt = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const dayFmt = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
const asUtc = (local: string) => new Date(`${local.slice(0, 10)}T00:00:00Z`);

const byMonth = new Map<string, Event[]>();
for (const e of events) {
  const key = monthFmt.format(asUtc(e.start));
  byMonth.set(key, [...(byMonth.get(key) ?? []), e]);
}

const used = Object.keys(CATEGORIES).filter((c) => events.some((e) => e.categories.includes(c as Category))) as Category[];
const hasUnclassified = events.some((e) => e.categories.length === 0);
const when = (e: Event) => {
  const day = dayFmt.format(asUtc(e.start));
  if (isAllDay(e)) return e.end && e.end !== e.start ? `${day} – ${dayFmt.format(asUtc(e.end))}` : day;
  const time = e.start.slice(11);
  const endTime = e.end?.slice(0, 10) === e.start.slice(0, 10) ? `–${e.end.slice(11)}` : '';
  return `${day}, ${time}${endTime}`;
};
---

<Base title="Brussels Trainee Events" description="Free-time events for EU trainees in Brussels in one place." current="events">
    <header>
      <h1>Upcoming events</h1>
      <p>Networking, receptions, culture and Christmas markets for trainees in Brussels, all in one list.</p>
      <p><a class="subscribe" href={`${base}/events.ics`}>Subscribe in your calendar (.ics)</a> · <a href={`${base}/sources/`}>Which sources are covered?</a></p>
    </header>

    <nav class="filters" aria-label="Filter by category">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      {used.map((c) => <button type="button" data-filter={c} aria-pressed="false">{CATEGORIES[c]}</button>)}
      {hasUnclassified && <button type="button" data-filter="unclassified" aria-pressed="false">Unclassified</button>}
    </nav>

    <main>
      {events.length === 0 && <p class="empty">No upcoming events yet.</p>}
      {[...byMonth].map(([month, list]) => (
        <section>
          <h2>{month}</h2>
          <ul>
            {list.map((e) => (
              <li class="event" data-categories={e.categories.length ? e.categories.join(' ') : 'unclassified'} data-end={(e.end ?? e.start).slice(0, 10)}>
                <div class="when">{when(e)}</div>
                <div class="what">
                  {e.registration === 'invitation' && <p class="invite">{REGISTRATION.invitation}</p>}
                  <h3>{e.url ? <a href={e.url} rel="noopener">{e.title}</a> : e.title}</h3>
                  <p class="meta">
                    {e.categories.map((c) => <span class="tag">{CATEGORIES[c]}</span>)}
                    {e.organiser}
                    {e.location && <> · {e.location}</>}
                    {e.registration === 'required' && <> · <strong>{REGISTRATION.required}</strong></>}
                  </p>
                  {e.description && <p class="desc">{e.description}</p>}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </main>

    <script>
      // Hide events that ended since the last build, and handle category filters.
      const today = new Date().toISOString().slice(0, 10);
      const items = [...document.querySelectorAll<HTMLElement>('.event')];
      for (const li of items) if ((li.dataset.end ?? '') < today) li.remove();

      const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      const apply = (filter: string) => {
        for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
        for (const li of document.querySelectorAll<HTMLElement>('.event')) {
          li.hidden = filter !== 'all' && !(li.dataset.categories ?? '').split(' ').includes(filter);
        }
        for (const section of document.querySelectorAll<HTMLElement>('main section')) {
          section.hidden = !section.querySelector('.event:not([hidden])');
        }
      };
      for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.filter ?? 'all'));
      apply('all');
    </script>

    <style is:global>
      .subscribe { font-weight: 600; }
      .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0; }
      .filters button {
        border: 1px solid var(--line);
        background: transparent;
        color: var(--fg);
        padding: 4px 12px;
        border-radius: 999px;
        font: inherit;
        cursor: pointer;
      }
      .filters button[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--bg); }
      .event { display: grid; grid-template-columns: 9.5rem 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
      .when { color: var(--muted); font-variant-numeric: tabular-nums; }
      .what h3 { margin: 0; font-size: 1rem; }
      .meta, .desc { margin: 4px 0 0; color: var(--muted); font-size: 0.9rem; }
      .tag { background: var(--tag-bg); border-radius: 4px; padding: 1px 6px; margin-right: 6px; color: var(--fg); }
      .invite {
        display: inline-block;
        margin: 0 0 4px;
        padding: 1px 8px;
        border-radius: 4px;
        background: var(--invite-bg);
        color: var(--invite-fg);
        font-size: 0.8rem;
        font-weight: 600;
      }
      .empty { color: var(--muted); }
      @media (max-width: 520px) {
        .event { grid-template-columns: 1fr; gap: 2px; }
      }
    </style>
</Base>

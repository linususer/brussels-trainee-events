---
import Base from '../layouts/Base.astro';
import { CATEGORIES, REGISTRATION, isAllDay, type Category, type Event } from '../lib/event';
import { siteEvents } from '../lib/published';
import { buildMonths } from '../lib/calendar';
import { eventSlug, googleEventLink } from '../lib/subscribe';
import { feedForCategory } from '../lib/feeds';
import { lastFetch } from '../lib/load';
import { AFTER_WORK_FROM, fitsAroundWork } from '../lib/workday';

const events = siteEvents();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const thisMonth = new Date().toISOString().slice(0, 7);
// Months without events are skipped (except the current one), so a far-off event doesn't add empty grids.
const months = buildMonths(events, thisMonth, 12).filter((m) => m.key === thisMonth || m.weeks.flat().some((d) => d.inMonth && d.events.length));

const monthFmt = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const dayFmt = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
const longDayFmt = new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
const asUtc = (local: string) => new Date(`${local.slice(0, 10)}T00:00:00Z`);

const byMonth = new Map<string, Event[]>();
for (const e of events) {
  const key = monthFmt.format(asUtc(e.start));
  byMonth.set(key, [...(byMonth.get(key) ?? []), e]);
}

const used = Object.keys(CATEGORIES).filter((c) => events.some((e) => e.categories.includes(c as Category))) as Category[];
const hasUnclassified = events.some((e) => e.categories.length === 0);
const cats = (e: Event) => (e.categories.length ? e.categories.join(' ') : 'unclassified');
const when = (e: Event) => {
  const day = dayFmt.format(asUtc(e.start));
  if (isAllDay(e)) return e.end && e.end !== e.start ? `${day} – ${dayFmt.format(asUtc(e.end))}` : day;
  const time = e.start.slice(11);
  const endTime = e.end?.slice(0, 10) === e.start.slice(0, 10) ? `–${e.end.slice(11)}` : '';
  return `${day}, ${time}${endTime}`;
};
const shortDay = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const timeOf = (e: Event, date: string) => {
  if (e.start.slice(0, 10) === date) {
    if (!isAllDay(e)) return e.start.slice(11);
    // Long all-day events (exhibitions) are shown once, with their end date.
    return e.end && e.end.slice(0, 10) !== date ? `until ${shortDay.format(asUtc(e.end))}` : 'All day';
  }
  // Long events reappear on the 1st of later months.
  if (isAllDay(e) && e.end && e.end.slice(0, 10) > date && date.endsWith('-01')) return `until ${shortDay.format(asUtc(e.end))}`;
  // Later days of a multi-day event.
  return e.end?.slice(0, 10) === date && e.end.includes('T') ? `until ${e.end.slice(11)}` : 'cont.';
};
const icsHref = (e: Event) => `${base}/calendar/event/${eventSlug(e.id)}.ics`;

// When events were last collected, in Brussels time.
const fetchedAt = lastFetch();
const updated = fetchedAt
  ? new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Brussels' }).format(new Date(fetchedAt))
  : undefined;

// "Add to calendar" preselects the feed matching the current filter.
const filterFeeds = Object.fromEntries([['all', 'all'], ['unclassified', 'all'], ...used.map((c) => [c, feedForCategory(c)])]);
---

<Base title="Brussels Trainee Events" description="Free-time events for EU trainees in Brussels in one place." current="events">
  <header>
    <h1>Upcoming events</h1>
    <p>Networking, receptions, culture and policy talks for trainees in Brussels.</p>
    <p class="updated">
      New events are collected <strong>every night</strong> (around 05:15 Brussels time){updated && <>. Last update: <time datetime={fetchedAt}>{updated}</time></>}.
      {' '}<a href={`${base}/sources/`}>Which organisers are covered?</a>
    </p>
    <p class="calendar-tip">
      <span aria-hidden="true">📅</span>
      <span><strong>Tip:</strong> <a id="cal-link" href={`${base}/subscribe/`} data-filter-feeds={JSON.stringify(filterFeeds)}>add these events to your calendar</a>. They update by
      themselves every night, so you don't need to come back to this website.</span>
    </p>
  </header>

  <div class="toolbar">
    <nav class="filters" aria-label="Filter by category">
      <button type="button" data-filter="all" data-label="All" aria-pressed="true">All <span class="n"></span></button>
      {used.map((c) => <button type="button" data-filter={c} data-label={CATEGORIES[c]} aria-pressed="false">{CATEGORIES[c]} <span class="n"></span></button>)}
      {hasUnclassified && <button type="button" data-filter="unclassified" data-label="Unclassified" aria-pressed="false">Unclassified <span class="n"></span></button>}
      <button type="button" class="afterwork" id="afterwork" aria-pressed="false" title={`Weekdays only from ${AFTER_WORK_FROM}; weekends and all-day events always`}>
        <span aria-hidden="true">🕑</span> Outside work hours
      </button>
    </nav>
    <p class="afterwork-note" id="afterwork-note" hidden>Weekday events from {AFTER_WORK_FROM}, weekend and all-day events at any time.</p>
    <div class="toolbar-right">
      <div class="views" role="group" aria-label="View">
        <button type="button" data-view="list" aria-pressed="true">List</button>
        <button type="button" data-view="month" aria-pressed="false">Month</button>
      </div>
    </div>
  </div>


  <p class="showing" id="showing" aria-live="polite"></p>
  <div class="empty-filter" id="empty-filter" hidden>
    <p>No <span data-empty-label></span> events in the coming weeks.</p>
    <button type="button" class="btn" data-filter-reset>Show all events</button>
  </div>

  <main>
    {events.length === 0 && <p class="empty">No upcoming events yet. New events are collected every night.</p>}

    <div class="view view-list" data-view-panel="list">
      {[...byMonth].map(([month, list]) => (
        <section class="month-list">
          <h2>{month}</h2>
          <ul>
            {list.map((e) => (
              <li class="event" id={`ev-${eventSlug(e.id)}`} data-categories={cats(e)} data-afterwork={String(fitsAroundWork(e))} data-end={(e.end ?? e.start).slice(0, 10)}>
                <div class="when">{when(e)}</div>
                <div class="what">
                  {e.registration === 'invitation' && <p class="invite">{REGISTRATION.invitation}</p>}
                  <h3>{e.url ? <a href={e.url} rel="noopener">{e.title}</a> : e.title}</h3>
                  <p class="meta">
                    {e.categories.map((c) => <span class="tag">{CATEGORIES[c]}</span>)}
                    {e.organiser}
                    {e.location && <> · {e.location}</>}
                  </p>
                  {e.description && <p class="desc">{e.description}</p>}
                  {e.url && e.registration === 'required' && <p class="next-step"><a href={e.url} rel="noopener">Register on the organiser's page →</a></p>}
                  {e.url && e.registration === 'invitation' && <p class="next-step"><a href={e.url} rel="noopener">Ask the organiser for an invitation →</a></p>}
                  <div class="add">
                    <span class="add-label">Add this event:</span>
                    <a class="btn btn-small" href={googleEventLink(e)} target="_blank" rel="noopener" data-add="google">Google Calendar</a>
                    <a class="btn btn-small" href={icsHref(e)} download data-add="ics">Apple, Outlook &amp; others</a>
                  </div>
                  <p class="status" role="status" aria-live="polite" hidden></p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="view view-month" data-view-panel="month" hidden>
      {months.map((m) => (
        <section class="cal-month" data-month={m.key}>
          <h2>{m.label}</h2>
          <div class="cal-grid" role="grid" aria-label={m.label}>
            {['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((d) => <div class="cal-dow" role="columnheader">{d}</div>)}
            {m.weeks.flat().map((day) => (
              <div class={`cal-day${day.inMonth ? '' : ' cal-out'}`} data-date={day.date} role="gridcell">
                {day.inMonth && day.events.length > 0 ? (
                  <button type="button" class="cal-daybtn" data-day={day.date} aria-label={`${longDayFmt.format(asUtc(day.date))}: show events`}>
                    <span class="cal-num">{Number(day.date.slice(8))}</span>
                    <span class="cal-count" aria-hidden="true">{day.events.length}</span>
                  </button>
                ) : (
                  <span class="cal-num">{day.inMonth ? Number(day.date.slice(8)) : ''}</span>
                )}
                {day.inMonth &&
                  day.events.map((e) => (
                    <a class="cal-chip" href={`#day-${day.date}`} data-day={day.date} data-categories={cats(e)} data-afterwork={String(fitsAroundWork(e))} title={`${timeOf(e, day.date)} ${e.title}`}>
                      <span class="cal-time">{timeOf(e, day.date)}</span> {e.title}
                    </a>
                  ))}
              </div>
            ))}
          </div>
          {m.weeks.flat().filter((d) => d.inMonth && d.events.length).map((day) => (
            <div class="cal-panel" id={`day-${day.date}`} data-panel={day.date} hidden>
              <h3>{longDayFmt.format(asUtc(day.date))}</h3>
              <ul>
                {day.events.map((e) => (
                  <li data-categories={cats(e)} data-afterwork={String(fitsAroundWork(e))}>
                    <span class="cal-time">{timeOf(e, day.date)}</span>
                    {e.url ? <a href={e.url} rel="noopener" class="cal-panel-title">{e.title}</a> : <span class="cal-panel-title">{e.title}</span>}
                    <span class="cal-panel-meta">
                      {e.organiser}
                      {e.registration === 'invitation' && <> · {REGISTRATION.invitation}</>}
                    </span>
                    <span class="cal-panel-add">
                      <a class="btn btn-small" href={googleEventLink(e)} target="_blank" rel="noopener" data-add="google">Google Calendar</a>
                      <a class="btn btn-small" href={icsHref(e)} download data-add="ics">Apple, Outlook &amp; others</a>
                    </span>
                    <span class="status" role="status" aria-live="polite" hidden></span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </div>
  </main>

  <script>
    import { say } from '../scripts/subscribe-client';

    const today = new Date().toISOString().slice(0, 10);
    const thisMonth = today.slice(0, 7);

    // Drop what has ended since the last build.
    for (const li of document.querySelectorAll<HTMLElement>('.event')) if ((li.dataset.end ?? '') < today) li.remove();
    for (const m of document.querySelectorAll<HTMLElement>('.cal-month')) if ((m.dataset.month ?? '') < thisMonth) m.remove();
    for (const d of document.querySelectorAll<HTMLElement>('.cal-day')) {
      const date = d.dataset.date ?? '';
      d.classList.toggle('cal-past', date < today);
      d.classList.toggle('cal-today', date === today);
    }

    const events = [...document.querySelectorAll<HTMLElement>('.event')];
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    // "Outside work hours" combines with the category filter; remembered per browser.
    const afterWorkBtn = document.getElementById('afterwork') as HTMLButtonElement;
    const afterWorkNote = document.getElementById('afterwork-note')!;
    let afterWork = false;
    try {
      afterWork = localStorage.getItem('bte-afterwork') === '1';
    } catch {
      // storage unavailable: start with the toggle off
    }
    const inCategory = (el: HTMLElement, f: string) => f === 'all' || (el.dataset.categories ?? '').split(' ').includes(f);
    const inFilter = (el: HTMLElement, f: string) => inCategory(el, f) && (!afterWork || el.dataset.afterwork === 'true');

    // Counts on the filter buttons follow the work-hours toggle.
    const updateCounts = () => {
      for (const b of filterButtons) {
        const n = events.filter((li) => inFilter(li, b.dataset.filter ?? 'all')).length;
        b.querySelector('.n')!.textContent = String(n);
        b.setAttribute('aria-label', `${b.dataset.label}: ${n} events`);
      }
    };

    // The tip's calendar link opens the subscription page with the current filter preselected.
    const calLink = document.getElementById('cal-link') as HTMLAnchorElement;
    const filterFeeds = JSON.parse(calLink.dataset.filterFeeds ?? '{}') as Record<string, string>;
    const updateCalLink = (filter: string, label: string) => {
      const feed = (filterFeeds[filter] ?? 'all') + (afterWork ? '-afterwork' : '');
      calLink.href = feed === 'all' ? calLink.pathname : `${calLink.pathname}?feed=${feed}`;
      const scope = filter === 'all' || filter === 'unclassified' ? 'all' : label;
      calLink.setAttribute('aria-label', `Add ${scope} events${afterWork ? ' outside work hours' : ''} to your calendar`);
    };

    // Category filter for list, calendar chips and day panels, with a status line and an empty state.
    let filter = 'all';
    const showing = document.getElementById('showing')!;
    const emptyBox = document.getElementById('empty-filter')!;
    const applyFilter = () => {
      updateCounts();
      afterWorkBtn.setAttribute('aria-pressed', String(afterWork));
      afterWorkNote.hidden = !afterWork;
      for (const b of filterButtons) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
      for (const el of document.querySelectorAll<HTMLElement>('.event, .cal-chip, .cal-panel li')) el.hidden = !inFilter(el, filter);
      for (const s of document.querySelectorAll<HTMLElement>('.month-list')) s.hidden = !s.querySelector('.event:not([hidden])');
      for (const btn of document.querySelectorAll<HTMLButtonElement>('.cal-daybtn')) {
        const n = btn.parentElement!.querySelectorAll('.cal-chip:not([hidden])').length;
        btn.querySelector('.cal-count')!.textContent = String(n);
        btn.disabled = n === 0;
        btn.parentElement!.classList.toggle('cal-has', n > 0);
      }
      const n = events.filter((li) => !li.hidden).length;
      const label = filterButtons.find((b) => b.dataset.filter === filter)?.dataset.label ?? '';
      const what = filter === 'all' ? `${n} upcoming ${n === 1 ? 'event' : 'events'}` : `${n} ${label} ${n === 1 ? 'event' : 'events'}`;
      showing.textContent = `Showing ${filter === 'all' && !afterWork ? 'all ' : ''}${what}${afterWork ? ' outside work hours' : ''}`;
      emptyBox.hidden = n > 0 || events.length === 0;
      emptyBox.querySelector('[data-empty-label]')!.textContent = `${filter === 'all' ? '' : label}${afterWork ? ' after-work' : ''}`.trim() || 'upcoming';
      updateCalLink(filter, label);
    };
    for (const b of filterButtons) b.addEventListener('click', () => ((filter = b.dataset.filter ?? 'all'), applyFilter()));
    document.querySelector('[data-filter-reset]')?.addEventListener('click', () => {
      filter = 'all';
      afterWork = false;
      try {
        localStorage.setItem('bte-afterwork', '0');
      } catch {
        // ignore
      }
      applyFilter();
    });
    afterWorkBtn.addEventListener('click', () => {
      afterWork = !afterWork;
      try {
        localStorage.setItem('bte-afterwork', afterWork ? '1' : '0');
      } catch {
        // ignore
      }
      applyFilter();
    });

    // List / month view, remembered per browser.
    const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const setView = (view: string) => {
      for (const b of viewButtons) b.setAttribute('aria-pressed', String(b.dataset.view === view));
      for (const p of document.querySelectorAll<HTMLElement>('[data-view-panel]')) p.hidden = p.dataset.viewPanel !== view;
      try {
        localStorage.setItem('bte-view', view);
      } catch {
        // storage unavailable (private mode): the choice just isn't remembered
      }
    };
    for (const b of viewButtons) b.addEventListener('click', () => setView(b.dataset.view ?? 'list'));
    let saved = 'list';
    try {
      saved = localStorage.getItem('bte-view') ?? 'list';
    } catch {
      // ignore
    }

    // Month view: a day (or one of its events) opens that day's panel right below the month.
    const openDay = (date: string) => {
      const btn = document.querySelector<HTMLButtonElement>(`.cal-daybtn[data-day="${date}"]`);
      if (!btn) return;
      const month = btn.closest('.cal-month')!;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      for (const other of month.querySelectorAll('.cal-daybtn')) other.setAttribute('aria-expanded', 'false');
      for (const p of month.querySelectorAll<HTMLElement>('.cal-panel')) p.hidden = isOpen || p.dataset.panel !== date;
      btn.setAttribute('aria-expanded', String(!isOpen));
      if (!isOpen) month.querySelector<HTMLElement>(`.cal-panel[data-panel="${date}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };
    for (const btn of document.querySelectorAll<HTMLButtonElement>('.cal-daybtn')) btn.addEventListener('click', () => openDay(btn.dataset.day!));
    for (const chip of document.querySelectorAll<HTMLAnchorElement>('.cal-chip')) {
      chip.addEventListener('click', (ev) => {
        ev.preventDefault();
        const btn = document.querySelector<HTMLButtonElement>(`.cal-daybtn[data-day="${chip.dataset.day}"]`);
        if (btn?.getAttribute('aria-expanded') !== 'true') openDay(chip.dataset.day!);
      });
    }

    // Confirmation after adding a single event.
    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-add]')) {
      a.addEventListener('click', () => {
        const status = a.closest('li')?.querySelector<HTMLElement>('.status');
        if (!status) return;
        say(
          status,
          a.dataset.add === 'google'
            ? 'Google Calendar opens in a new tab. Click “Save” there.'
            : 'Downloaded. Open the file (usually in your downloads) and your calendar app adds the event.',
        );
      });
    }

    setView(saved === 'month' ? 'month' : 'list');
    applyFilter();
  </script>

  <style is:global>
    .toolbar-right { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .filters .afterwork { border-style: dashed; }
    .filters .afterwork[aria-pressed='true'] { border-style: solid; }
    .afterwork-note { margin: -12px 0 12px; color: var(--muted); font-size: 0.85rem; }
    .updated { font-size: 0.9rem; }
    .calendar-tip {
      display: flex;
      gap: 8px;
      margin: 12px 0 0;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--tag-bg);
      color: var(--fg) !important;
      font-size: 0.92rem;
    }
    .showing { margin: 4px 0 0; color: var(--muted); font-size: 0.88rem; }
    .empty-filter { margin: 16px 0; padding: 14px; border: 1px dashed var(--line); border-radius: 8px; text-align: center; }
    .empty-filter p { margin: 0 0 8px; }
    .filters .n { font-size: 0.78rem; opacity: 0.75; font-variant-numeric: tabular-nums; margin-left: 2px; }
    .filters .n:empty { display: none; }
    .next-step { margin: 6px 0 0; font-weight: 600; font-size: 0.9rem; }
    .toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin: 20px 0; }
    .filters, .views { display: flex; flex-wrap: wrap; gap: 8px; }
    .filters button, .views button {
      border: 1px solid var(--line);
      background: transparent;
      color: var(--fg);
      padding: 4px 12px;
      border-radius: 999px;
      font: inherit;
      cursor: pointer;
    }
    .views { gap: 0; }
    .views button { border-radius: 0; }
    .views button:first-child { border-radius: 999px 0 0 999px; }
    .views button:last-child { border-radius: 0 999px 999px 0; margin-left: -1px; }
    .filters button[aria-pressed='true'], .views button[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--bg); }
    .event { display: grid; grid-template-columns: 9.5rem 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 12px; transition: background 0.6s; }
    .event.flash { background: var(--tag-bg); }
    .when { color: var(--muted); font-variant-numeric: tabular-nums; }
    .what h3 { margin: 0; font-size: 1rem; }
    .meta, .desc { margin: 4px 0 0; color: var(--muted); font-size: 0.9rem; }
    .add { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 8px 0 0; }
    .add-label { color: var(--muted); font-size: 0.82rem; }
    .event .status, .cal-panel .status { font-size: 0.85rem; padding: 6px 10px; margin-top: 6px; }
    .tag { background: var(--tag-bg); border-radius: 4px; padding: 1px 6px; margin-right: 6px; color: var(--fg); }
    .invite {
      display: inline-block;
      margin: 0 0 4px;
      padding: 1px 8px;
      border-radius: 4px;
      background: var(--invite-bg);
      color: var(--invite-fg);
      font-size: 0.8rem;
      font-weight: 600;
    }
    .empty { color: var(--muted); }

    /* Month view */
    .cal-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
    .cal-dow { padding: 4px 6px; font-size: 0.75rem; color: var(--muted); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .cal-day { min-height: 92px; padding: 4px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .cal-out { background: color-mix(in srgb, var(--line) 25%, transparent); }
    .cal-past { opacity: 0.45; }
    /* Today: an outlined ring, distinct from the filled count badges on phones. */
    .cal-today .cal-num { box-shadow: inset 0 0 0 2px var(--accent); border-radius: 999px; padding: 0 6px; font-weight: 700; }
    .cal-num { font-size: 0.8rem; font-variant-numeric: tabular-nums; align-self: flex-start; }
    .cal-daybtn { display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 0; border: 0; background: transparent; color: var(--fg); font: inherit; cursor: pointer; }
    .cal-daybtn:disabled { cursor: default; }
    .cal-daybtn[aria-expanded='true'] .cal-num { text-decoration: underline; font-weight: 700; }
    .cal-count { display: none; }
    .cal-chip {
      display: block;
      padding: 2px 4px;
      border-radius: 4px;
      background: var(--tag-bg);
      color: var(--fg);
      font-size: 0.72rem;
      line-height: 1.25;
      text-decoration: none;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .cal-chip:hover, .cal-chip:focus-visible { outline: 1px solid var(--accent); }
    .cal-time { font-variant-numeric: tabular-nums; color: var(--muted); }
    .cal-panel { margin: 10px 0 4px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; }
    .cal-panel h3 { margin: 0 0 6px; font-size: 1rem; }
    .cal-panel li { display: grid; grid-template-columns: 4.2rem 1fr; gap: 2px 8px; padding: 6px 0; border-top: 1px solid var(--line); }
    .cal-panel li:first-child { border-top: 0; }
    .cal-panel-title { font-weight: 600; }
    .cal-panel-meta { grid-column: 2; color: var(--muted); font-size: 0.85rem; }
    .cal-panel-add { grid-column: 2; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
    .cal-panel .status { grid-column: 2; }
    .cal-month { margin-bottom: 8px; }

    @media (max-width: 560px) {
      .event { grid-template-columns: 1fr; gap: 2px; }
      .cal-day { min-height: 52px; padding: 3px; }
      .cal-chip { display: none; }
      .cal-count {
        display: inline-flex;
